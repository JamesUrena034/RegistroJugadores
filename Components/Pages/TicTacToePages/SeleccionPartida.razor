@page "/SeleccionPartida"

@rendermode InteractiveServer
@using RegistroJugadores.Models.ApiDtos
@using RegistroJugadores.Shared
@using RegistroJugadoresServer.Services
@inject IPartidasApiService PartidasApi
@inject NavigationManager Nav

<PageTitle>Unirse a una partida</PageTitle>

<div class="container mt-5 p-4 bg-white rounded shadow text-center" style="max-width:600px;">
    <h2 class="mb-4">Unirse a una partida existente</h2>

    @if (Estado is Resource<string>.Loading)
    {
        <div class="alert alert-info">Conectando con el servidor...</div>
    }
    else if (Estado is Resource<string>.Error e)
    {
        <div class="alert alert-danger">@e.Message</div>
    }
    else if (Estado is Resource<string>.Success s && !string.IsNullOrEmpty(s.Data))
    {
        <div class="alert alert-success">@s.Data</div>
    }

    <div class="mb-3">
        <label class="form-label fw-bold">ID de la partida</label>
        <input type="number" class="form-control" @bind="PartidaId" placeholder="Ejemplo: 5" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Selecciona jugador</label>
        <select class="form-select" @bind="RolSeleccionado">
            <option value="">-- Selecciona jugador --</option>
            <option value="X">Jugador X</option>
            <option value="O">Jugador O</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Tu ID de jugador</label>
        <input type="number" class="form-control" @bind="JugadorId" placeholder="Ejemplo: 3" />
    </div>

    <button class="btn btn-primary w-100" @onclick="UnirsePartida" disabled="@Cargando">
        @(Cargando ? "Conectando..." : "Unirse a la partida")
    </button>
</div>

@code {
    private int PartidaId;
    private string RolSeleccionado = "";
    private int JugadorId;
    private bool Cargando;
    private Resource<string> Estado = new Resource<string>.Success("");

    private async Task UnirsePartida()
    {
        if (PartidaId <= 0)
        {
            Estado = new Resource<string>.Error("Debe ingresar un ID válido.");
            return;
        }

        if (string.IsNullOrEmpty(RolSeleccionado))
        {
            Estado = new Resource<string>.Error("Debe seleccionar si será jugador X u O.");
            return;
        }

        if (JugadorId <= 0)
        {
            Estado = new Resource<string>.Error("Debe ingresar su ID de jugador.");
            return;
        }

        try
        {
            Cargando = true;
            Estado = new Resource<string>.Loading();

            var result = await PartidasApi.UnirsePorRolAsync(PartidaId, JugadorId, RolSeleccionado);

            switch (result)
            {
                case Resource<PartidaResponse>.Success s:
                    Estado = new Resource<string>.Success($"Te has unido correctamente como jugador {RolSeleccionado}.");
                    await Task.Delay(1200);
                    Nav.NavigateTo($"/GameBoard?partidaId={PartidaId}&jugador={RolSeleccionado}&jugadorId={JugadorId}");
                    break;

                case Resource<PartidaResponse>.Error e:
                    Estado = new Resource<string>.Error(e.Message ?? "No se pudo unir a la partida.");
                    break;

                default:
                    Estado = new Resource<string>.Error("No se recibió respuesta del servidor.");
                    break;
            }
        }
        catch (Exception ex)
        {
            Estado = new Resource<string>.Error($"Error inesperado: {ex.Message}");
        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }
}
