@page "/GameBoard"
@rendermode InteractiveServer
@using RegistroJugadores.Models.ApiDtos
@using RegistroJugadores.Shared
@using RegistroJugadoresServer.Services
@inject IPartidasApiService PartidasApi
@inject IMovimientosApiService MovimientosApi
@inject NavigationManager Nav

<PageTitle>Tic Tac Toe</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="text-center">
        <h2>Partida #@PartidaId - Jugador @JugadorActual</h2>

        <div class="d-flex justify-content-center mt-4">
            <div class="game-board">
                @for (var i = 0; i < 9; i++)
                {
                    var fila = i / 3;
                    var col = i % 3;
                    <button class="btn btn-outline-dark fs-2 fw-bold m-1"
                            style="width: 90px; height: 90px;"
                            @onclick="() => RealizarMovimiento(fila, col)"
                            disabled="@(!PuedeJugar(fila, col))">
                        @Tablero[fila, col]
                    </button>
                }
            </div>
        </div>

        <div class="mt-4">
            <h4>@EstadoTexto</h4>
        </div>

        <button class="btn btn-secondary mt-3" @onclick="Salir">Salir</button>
    </div>
</div>

@code {
    private int PartidaId;
    private string JugadorActual = "";
    private int JugadorId;
    private char[,] Tablero = new char[3, 3];
    private string EstadoTexto = "Cargando partida...";
    private System.Timers.Timer? Timer;
    private readonly SemaphoreSlim _lock = new(1, 1);
    private bool EnJuego = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("partidaId", out var idStr) || !int.TryParse(idStr, out PartidaId))
        {
            EstadoTexto = "No se recibió un ID de partida válido.";
            return;
        }

        if (query.TryGetValue("jugador", out var rol))
            JugadorActual = rol!;
        if (query.TryGetValue("jugadorId", out var idJugador))
            int.TryParse(idJugador!, out JugadorId);

        await CargarTablero();

        Timer = new System.Timers.Timer(2000);
        Timer.Elapsed += async (_, _) => await InvokeAsync(CargarTablero);
        Timer.Start();
    }

    private async Task CargarTablero()
    {
        await _lock.WaitAsync();
        try
        {
            var movimientos = await MovimientosApi.GetMovimientosAsync(PartidaId);
            InicializarTablero();

            if (movimientos is Resource<List<MovimientosResponse>>.Success ok)
            {
                foreach (var m in ok.Data)
                {
                    if (m.PosicionFila is >= 0 and < 3 && m.PosicionColumna is >= 0 and < 3)
                        Tablero[m.PosicionFila, m.PosicionColumna] = m.Jugador == "X" ? 'X' : 'O';
                }

                var ganador = DetectarGanador();
                if (ganador != null)
                {
                    EstadoTexto = $"🏆 ¡Ganador: {ganador}!";
                    EnJuego = false;
                }
                else if (DetectarEmpate())
                {
                    EstadoTexto = "🤝 ¡Empate!";
                    EnJuego = false;
                }
                else
                {
                    // Calcular turno real basado en la cantidad de movimientos
                    int countX = ok.Data.Count(m => m.Jugador == "X");
                    int countO = ok.Data.Count(m => m.Jugador == "O");
                    string turnoActual = countX == countO ? "X" : "O";

                    EstadoTexto = turnoActual == JugadorActual
                        ? $"👉 Es tu turno ({turnoActual})"
                        : $"⏳ Esperando turno del jugador {turnoActual}";
                }

                StateHasChanged();
            }
        }
        finally
        {
            _lock.Release();
        }
    }

    private async Task RealizarMovimiento(int fila, int col)
    {
        if (!PuedeJugar(fila, col)) return;

        await _lock.WaitAsync();
        try
        {
            var movimiento = new MovimientosRequest
            {
                PartidaId = PartidaId,
                Jugador = JugadorActual,
                PosicionFila = fila,
                PosicionColumna = col
            };

            var resultado = await MovimientosApi.PostMovimientoAsync(movimiento);

            if (resultado is Resource<bool>.Success s && s.Data)
            {
                Tablero[fila, col] = JugadorActual[0];
                EstadoTexto = $"Movimiento realizado ({JugadorActual})";
            }
            else if (resultado is Resource<bool>.Error e)
            {
                EstadoTexto = e.Message ?? "No se pudo registrar el movimiento.";
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            EstadoTexto = $"Error: {ex.Message}";
        }
        finally
        {
            _lock.Release();
        }
    }

    private bool PuedeJugar(int fila, int col)
        => EnJuego && Tablero[fila, col] == '-';

    private void InicializarTablero()
    {
        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++)
                if (Tablero[i, j] == '\0')
                    Tablero[i, j] = '-';
    }

    private string? DetectarGanador()
    {
        for (int i = 0; i < 3; i++)
        {
            if (Tablero[i, 0] != '-' && Tablero[i, 0] == Tablero[i, 1] && Tablero[i, 1] == Tablero[i, 2])
                return Tablero[i, 0].ToString();
            if (Tablero[0, i] != '-' && Tablero[0, i] == Tablero[1, i] && Tablero[1, i] == Tablero[2, i])
                return Tablero[0, i].ToString();
        }
        if (Tablero[0, 0] != '-' && Tablero[0, 0] == Tablero[1, 1] && Tablero[1, 1] == Tablero[2, 2])
            return Tablero[0, 0].ToString();
        if (Tablero[0, 2] != '-' && Tablero[0, 2] == Tablero[1, 1] && Tablero[1, 1] == Tablero[2, 0])
            return Tablero[0, 2].ToString();
        return null;
    }

    private bool DetectarEmpate()
    {
        foreach (var c in Tablero)
        {
            if (c == '-') return false;
        }
        return DetectarGanador() == null;
    }

    private void Salir()
    {
        Timer?.Stop();
        Nav.NavigateTo("/SeleccionPartida");
    }

    public void Dispose()
    {
        Timer?.Dispose();
    }
}
